# Copy to .env (gitignored). Existing environment variables take precedence.

# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# CAREER_AGENTS_MODEL=claude-opus-5-5

# Email digest (Gmail: create an app password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Telegram digest (optional): create a bot with @BotFather, then message it once to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
